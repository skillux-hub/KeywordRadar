# 复制为 .env 后按需填写。除了可选的 X token，所有发现源都能在没有付费密钥时运行。

# 公网访问密码。本地开发不设则不锁；生产环境（NODE_ENV=production）不设会拒绝打开。
APP_PASSWORD=
# 设为 true 且不设 APP_PASSWORD 时，网站公开访问、无需登录
PUBLIC_ACCESS=

# SQLite 目录。Docker / Fly / Render / Railway 挂卷到 /data。
DATA_DIR=

# X 数据接口，只读。官方 v2 或第三方二选一。都不填时，时间线暂停，账号仍从社区文本里自动发现。
X_BEARER_TOKEN=
# official（默认，有 token 就用）或 generic（走下面的第三方地址）
X_PROVIDER=
# 第三方接口根地址和密钥，例如 twitterapi.io / AIsa 一类的兼容服务。
X_PROVIDER_BASE_URL=
X_PROVIDER_API_KEY=
# bearer（默认，Authorization）或 x-api-key
X_PROVIDER_AUTH=bearer

# Reddit 官方 API。不配置则使用公开 RSS。
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# YouTube Data API。不配置仍会读频道 RSS（标题）。
YOUTUBE_API_KEY=

# 可选，提高 GitHub / Stack Exchange 配额
GITHUB_TOKEN=
STACKEXCHANGE_KEY=

# Product Hunt 官方 GraphQL。不配置则用公开 RSS。
PRODUCTHUNT_TOKEN=

# Discord：机器人必须已加入频道。不配置则关闭。
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_IDS=

# Telegram：不配置则关闭。频道用户名用逗号分隔，不要带 @。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL_USERNAMES=

# Threads 官方 API。不配置则关闭。
THREADS_ACCESS_TOKEN=

# SERP。都不配置时用 DuckDuckGo 公开结果做粗分类。
SERPAPI_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# 大纲。不配置则用启发式模板。兼容 OpenAI 的接口也可以。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# 日报外发。页面里始终看得到，不配置就不会往外发。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
DIGEST_EMAIL_TO=
DIGEST_WEBHOOK_URL=
DIGEST_HOUR=8
DIGEST_TZ=Asia/Shanghai

# 采集间隔（小时）
CRON_HOURS=4

# 自动发现。每个行业保留这么多账号 / 板块，每隔这么多天重排并退出不活跃的。
X_DISCOVERY_LIMIT=30
SUBREDDIT_DISCOVERY_LIMIT=15
DISCOVERY_INTERVAL_DAYS=7

# 确认窗口（小时）。两组来源必须落在这个窗口内才算确认，允许 24 到 48，默认 48。
CONFIRM_WINDOW_HOURS=48

GITHUB_BREAKOUT_MAX_AGE_DAYS=14
GITHUB_BREAKOUT_STARS_PER_DAY=200
GITHUB_BREAKOUT_STAR_DELTA=400
